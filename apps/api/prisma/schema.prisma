generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  ACCOUNTANT
  MEMBER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceLineDiscountKind {
  FLAT
  PERCENTAGE
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

enum IncomeExpenseType {
  INCOME
  EXPENSE
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CASH
  PAYMENT_PROCESSOR
  OTHER
}

enum BankAccountStatus {
  ACTIVE
  ARCHIVED
}

enum ReconciliationStatus {
  CONFIRMED
  REVERSED
}

enum ReconciliationMatchType {
  SUGGESTED
  MANUAL
}

model User {
  id                 String                @id @default(uuid()) @db.Uuid
  email              String                @unique(map: "users_email_key") @db.VarChar(320)
  displayName        String?               @map("display_name") @db.VarChar(120)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        WorkspaceMembership[]
  passwordCredential UserCredential?
  sessions           UserSession[]

  @@map("users")
}

model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model UserSession {
  id           String   @id @db.Char(43)
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  lastActiveAt DateTime @map("last_active_at") @db.Timestamptz(3)
  metadata     Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "user_sessions_user_id_expires_at_idx")
  @@index([expiresAt], map: "user_sessions_expires_at_idx")
  @@map("user_sessions")
}

model Workspace {
  id                      String                  @id @default(uuid()) @db.Uuid
  name                    String                  @db.VarChar(120)
  slug                    String                  @unique(map: "workspaces_slug_key") @db.VarChar(100)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  bankAccounts            BankAccount[]
  bankTransactions        BankTransaction[]
  customers               Customer[]
  incomeExpenseCategories IncomeExpenseCategory[]
  incomeExpenseEntries    IncomeExpenseEntry[]
  invoices                Invoice[]
  memberships             WorkspaceMembership[]
  payments                Payment[]
  reconciliations         Reconciliation[]
  vendors                 Vendor[]

  @@map("workspaces")
}

model IncomeExpenseCategory {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  type        IncomeExpenseType @map("category_type")
  name        String            @db.VarChar(120)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  entries   IncomeExpenseEntry[]
  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id], map: "income_expense_categories_workspace_id_id_key")
  @@unique([workspaceId, type, name], map: "income_expense_categories_workspace_id_type_name_key")
  @@index([workspaceId, type, name], map: "income_expense_categories_workspace_id_type_name_idx")
  @@map("income_expense_categories")
}

model WorkspaceMembership {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([workspaceId, userId], map: "workspace_memberships_pkey")
  @@index([userId], map: "workspace_memberships_user_id_idx")
  @@index([workspaceId, role], map: "workspace_memberships_workspace_id_role_idx")
  @@map("workspace_memberships")
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(120)
  contactName String   @map("contact_name") @db.VarChar(120)
  email       String   @db.VarChar(254)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  invoices  Invoice[]

  @@unique([workspaceId, id], map: "customers_workspace_id_id_key")
  @@unique([workspaceId, name], map: "customers_workspace_id_name_key")
  @@map("customers")
}

model Vendor {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(120)
  contactName String   @map("contact_name") @db.VarChar(120)
  email       String   @db.VarChar(254)
  category    String   @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  incomeExpenseEntries IncomeExpenseEntry[]

  @@unique([workspaceId, id], map: "vendors_workspace_id_id_key")
  @@unique([workspaceId, name], map: "vendors_workspace_id_name_key")
  @@index([workspaceId, category], map: "vendors_workspace_id_category_idx")
  @@map("vendors")
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  workspaceId        String        @map("workspace_id") @db.Uuid
  customerId         String        @map("customer_id") @db.Uuid
  invoiceNumber      String        @map("invoice_number") @db.VarChar(64)
  status             InvoiceStatus @default(DRAFT)
  issueDate          DateTime      @map("issue_date") @db.Date
  dueDate            DateTime      @map("due_date") @db.Date
  currency           String        @db.Char(3)
  subtotalMinorUnits BigInt        @map("subtotal_minor_units") @db.BigInt
  discountMinorUnits BigInt        @map("discount_minor_units") @db.BigInt
  taxMinorUnits      BigInt        @map("tax_minor_units") @db.BigInt
  totalMinorUnits    BigInt        @map("total_minor_units") @db.BigInt
  notes              String?       @db.Text
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer  Customer          @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  lineItems InvoiceLineItem[]
  payments  Payment[]
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id], map: "invoices_workspace_id_id_key")
  @@unique([workspaceId, invoiceNumber], map: "invoices_workspace_id_invoice_number_key")
  @@index([workspaceId, customerId], map: "invoices_workspace_id_customer_id_idx")
  @@index([workspaceId, status, dueDate], map: "invoices_workspace_id_status_due_date_idx")
  @@map("invoices")
}

model InvoiceLineItem {
  id                      String                   @id @default(uuid()) @db.Uuid
  invoiceId               String                   @map("invoice_id") @db.Uuid
  position                Int
  description             String                   @db.VarChar(1000)
  quantity                Decimal                  @db.Decimal(18, 6)
  unitPriceMinorUnits     BigInt                   @map("unit_price_minor_units") @db.BigInt
  taxRateBasisPoints      Int                      @default(0) @map("tax_rate_basis_points")
  discountKind            InvoiceLineDiscountKind? @map("discount_kind")
  discountFlatMinorUnits  BigInt?                  @map("discount_flat_minor_units") @db.BigInt
  discountRateBasisPoints Int?                     @map("discount_rate_basis_points")
  subtotalMinorUnits      BigInt                   @map("subtotal_minor_units") @db.BigInt
  discountMinorUnits      BigInt                   @map("discount_minor_units") @db.BigInt
  taxMinorUnits           BigInt                   @map("tax_minor_units") @db.BigInt
  totalMinorUnits         BigInt                   @map("total_minor_units") @db.BigInt
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, position], map: "invoice_line_items_invoice_id_position_key")
  @@map("invoice_line_items")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  workspaceId      String        @map("workspace_id") @db.Uuid
  invoiceId        String        @map("invoice_id") @db.Uuid
  amountMinorUnits BigInt        @map("amount_minor_units") @db.BigInt
  receivedAt       DateTime      @map("received_at") @db.Timestamptz(3)
  method           PaymentMethod
  reference        String?       @db.VarChar(100)
  notes            String?       @db.Text
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice         Invoice          @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Restrict)
  reconciliations Reconciliation[]
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id], map: "payments_workspace_id_id_key")
  @@index([workspaceId, invoiceId], map: "payments_workspace_id_invoice_id_idx")
  @@index([workspaceId, receivedAt], map: "payments_workspace_id_received_at_idx")
  @@map("payments")
}

model IncomeExpenseEntry {
  id               String            @id @default(uuid()) @db.Uuid
  workspaceId      String            @map("workspace_id") @db.Uuid
  categoryId       String?           @map("category_id") @db.Uuid
  vendorId         String?           @map("vendor_id") @db.Uuid
  type             IncomeExpenseType @map("entry_type")
  amountMinorUnits BigInt            @map("amount_minor_units") @db.BigInt
  currency         String            @db.Char(3)
  occurredOn       DateTime          @map("occurred_on") @db.Date
  description      String            @db.VarChar(1000)
  reference        String?           @db.VarChar(100)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  category  IncomeExpenseCategory? @relation(fields: [workspaceId, categoryId], references: [workspaceId, id], onDelete: Restrict)
  vendor    Vendor?                @relation(fields: [workspaceId, vendorId], references: [workspaceId, id], onDelete: Restrict)
  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, categoryId], map: "income_expense_entries_workspace_id_category_id_idx")
  @@index([workspaceId, occurredOn], map: "income_expense_entries_workspace_id_occurred_on_idx")
  @@index([workspaceId, type, occurredOn], map: "income_expense_entries_workspace_id_type_occurred_on_idx")
  @@index([workspaceId, vendorId], map: "income_expense_entries_workspace_id_vendor_id_idx")
  @@map("income_expense_entries")
}

model BankAccount {
  id                       String            @id @default(uuid()) @db.Uuid
  workspaceId              String            @map("workspace_id") @db.Uuid
  name                     String            @db.VarChar(120)
  type                     BankAccountType   @map("account_type")
  status                   BankAccountStatus @default(ACTIVE)
  currency                 String            @db.Char(3)
  institutionName          String?           @map("institution_name") @db.VarChar(120)
  accountLastFour          String?           @map("account_last_four") @db.VarChar(4)
  openingBalanceMinorUnits BigInt            @default(0) @map("opening_balance_minor_units") @db.BigInt
  openingBalanceDate       DateTime?         @map("opening_balance_date") @db.Date
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  transactions BankTransaction[]
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id], map: "bank_accounts_workspace_id_id_key")
  @@unique([workspaceId, name], map: "bank_accounts_workspace_id_name_key")
  @@index([workspaceId, status], map: "bank_accounts_workspace_id_status_idx")
  @@map("bank_accounts")
}

model BankTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  bankAccountId    String   @map("bank_account_id") @db.Uuid
  externalId       String?  @map("external_id") @db.VarChar(255)
  amountMinorUnits BigInt   @map("amount_minor_units") @db.BigInt
  transactionDate  DateTime @map("transaction_date") @db.Date
  description      String   @db.VarChar(1000)
  reference        String?  @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bankAccount     BankAccount      @relation(fields: [workspaceId, bankAccountId], references: [workspaceId, id], onDelete: Restrict)
  reconciliations Reconciliation[]
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id], map: "bank_transactions_workspace_id_id_key")
  @@index([workspaceId, transactionDate], map: "bank_transactions_workspace_id_transaction_date_idx")
  @@index([bankAccountId, transactionDate], map: "bank_transactions_bank_account_id_transaction_date_idx")
  @@map("bank_transactions")
}

model Reconciliation {
  id                    String                  @id @default(uuid()) @db.Uuid
  workspaceId           String                  @map("workspace_id") @db.Uuid
  bankTransactionId     String                  @map("bank_transaction_id") @db.Uuid
  paymentId             String                  @map("payment_id") @db.Uuid
  status                ReconciliationStatus    @default(CONFIRMED)
  matchType             ReconciliationMatchType @map("match_type")
  confidenceBasisPoints Int?                    @map("confidence_basis_points")
  reconciledAt          DateTime                @default(now()) @map("reconciled_at") @db.Timestamptz(3)
  reversedAt            DateTime?               @map("reversed_at") @db.Timestamptz(3)
  note                  String?                 @db.Text
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  bankTransaction BankTransaction @relation(fields: [workspaceId, bankTransactionId], references: [workspaceId, id], onDelete: Restrict)
  payment         Payment         @relation(fields: [workspaceId, paymentId], references: [workspaceId, id], onDelete: Restrict)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status, reconciledAt], map: "reconciliations_workspace_id_status_reconciled_at_idx")
  @@map("reconciliations")
}
