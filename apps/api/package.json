{
  "name": "@finflow/api",
  "version": "0.1.0",
  "description": "FinFlow's NestJS API application.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
