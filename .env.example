# Environment variable policy
#
# Add only variable names and safe placeholder values to this file.
# Never commit credentials, tokens, private keys, connection strings, or real
# financial data. Keep actual local values in .env.local instead.
#
# Local PostgreSQL configuration for Docker Compose.
#
# Copy this file to .env.local before starting PostgreSQL, then replace the
# placeholder password. Keep the password used below consistent with the one in
# DATABASE_URL. These variables initialise the local database only.
POSTGRES_DB=finflow
POSTGRES_USER=finflow
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Prisma CLI reads this URL through apps/api/prisma7.config.ts.
# If your local password contains URL-reserved characters (such as @, :, /, or
# #), percent-encode it in this URL.
DATABASE_URL=postgresql://finflow:replace-with-a-local-development-password@localhost:5432/finflow?schema=public

# Origin of the separately hosted Next.js application. The API trusts this
# origin for authentication requests; production deployments must set it to
# their HTTPS web origin without a path.
WEB_ORIGIN=http://localhost:3000
